/* ========================================
   GOALS PREVIEW
   ======================================== */

.goals-preview-section {
    width: 100%;
    margin-bottom: 32px;
}

.dashboard-goals-list {
    width: 100%;
}

.dashboard-goals-empty {
    display: flex;
    align-items: center;

    gap: 16px;

    padding: 22px;

    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 16px;
}

.goals-empty-icon {
    width: 50px;
    height: 50px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 14px;

    background: #f3f1ff;

    font-size: 23px;
}

.goals-empty-content {
    flex: 1;
    min-width: 0;
}

.goals-empty-content h3 {
    margin: 0;

    font-size: 14px;
    font-weight: 750;

    color: #292c39;
}

.goals-empty-content p {
    margin-top: 5px;

    font-size: 12px;

    color: #858b9c;

    line-height: 1.5;
}

.create-goal-button {
    flex-shrink: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 10px 15px;

    border-radius: 9px;

    background: #536dfe;

    color: #ffffff;

    font-size: 12px;
    font-weight: 700;

    text-decoration: none;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.create-goal-button:hover {
    transform: translateY(-1px);

    box-shadow:
        0 6px 16px rgba(83, 109, 254, 0.22);
}


/* ---------- Goal item ---------- */

.dashboard-goal-item {
    padding: 18px;

    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 15px;

    margin-bottom: 10px;
}

.goal-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;
}

.goal-item-title {
    font-size: 14px;
    font-weight: 700;

    color: #292c39;
}

.goal-item-percentage {
    font-size: 12px;
    font-weight: 700;

    color: #536dfe;
}

.goal-progress {
    width: 100%;
    height: 7px;

    margin-top: 12px;

    overflow: hidden;

    background: #eef0f5;

    border-radius: 20px;
}

.goal-progress-fill {
    height: 100%;

    width: 0%;

    border-radius: inherit;

    background: #536dfe;

    transition: width 0.4s ease;
}


/* ---------- Mobile ---------- */

@media (max-width: 600px) {

    .dashboard-goals-empty {
        align-items: flex-start;

        flex-wrap: wrap;

        padding: 18px;
    }

    .goals-empty-content {
        padding-top: 2px;
    }

    .create-goal-button {
        width: 100%;
    }

}
