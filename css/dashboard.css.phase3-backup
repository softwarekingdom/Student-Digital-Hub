/* ========================================
   STUDENT DIGITAL HUB
   DASHBOARD - BASE + SIDEBAR
   ======================================== */


/* ---------- Base ---------- */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: #f6f8fc;
    color: #202331;

    min-height: 100vh;
}


/* ---------- Dashboard Layout ---------- */

.dashboard-layout {
    display: flex;
    min-height: 100vh;
}


/* ---------- Sidebar ---------- */

.dashboard-sidebar {
    width: 250px;
    min-height: 100vh;

    background: #ffffff;

    border-right: 1px solid #e8eaf0;

    display: flex;
    flex-direction: column;

    padding: 22px 16px;

    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;

    z-index: 100;
}


/* ---------- Brand ---------- */

.sidebar-brand {
    display: flex;
    align-items: center;

    gap: 11px;

    padding: 4px 8px 24px;
}

.brand-icon {
    width: 42px;
    height: 42px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #eef2ff;

    border-radius: 12px;

    font-size: 21px;
}

.brand-text {
    display: flex;
    flex-direction: column;

    line-height: 1.2;
}

.brand-text strong {
    font-size: 16px;
    font-weight: 750;

    color: #202331;
}

.brand-text span {
    font-size: 12px;

    color: #7b8194;

    margin-top: 3px;
}


/* ---------- Navigation ---------- */

.dashboard-nav {
    flex: 1;

    overflow-y: auto;

    padding-right: 2px;
}

.nav-section-title {
    font-size: 10px;
    font-weight: 750;

    letter-spacing: 1px;

    color: #9a9fad;

    padding: 16px 10px 8px;
}


.dashboard-nav-link {
    display: flex;
    align-items: center;

    gap: 12px;

    width: 100%;

    padding: 11px 12px;

    margin-bottom: 4px;

    border-radius: 10px;

    color: #62697b;

    text-decoration: none;

    font-size: 14px;
    font-weight: 550;

    transition:
        background 0.2s ease,
        color 0.2s ease,
        transform 0.2s ease;
}

.dashboard-nav-link:hover {
    background: #f4f6fb;
    color: #3f4fd9;
}

.dashboard-nav-link.active {
    background: #eef1ff;
    color: #4c5ce7;

    font-weight: 700;
}

.nav-icon {
    width: 22px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    font-size: 17px;
}


/* ---------- Sidebar Bottom ---------- */

.sidebar-bottom {
    padding-top: 14px;

    border-top: 1px solid #edf0f5;
}


.logout-button {
    width: 100%;

    border: none;
    background: transparent;

    display: flex;
    align-items: center;

    gap: 12px;

    padding: 11px 12px;

    border-radius: 10px;

    color: #62697b;

    font-size: 14px;
    font-weight: 550;

    cursor: pointer;

    text-align: left;

    transition:
        background 0.2s ease,
        color 0.2s ease;
}

.logout-button:hover {
    background: #fff1f1;
    color: #d94a4a;
}


/* ---------- Main Area ---------- */

.dashboard-main {
    flex: 1;

    min-width: 0;

    margin-left: 250px;

    padding: 28px 32px;

    min-height: 100vh;
}


/* ---------- Mobile ---------- */

@media (max-width: 768px) {

    .dashboard-sidebar {
        width: 72px;

        padding: 18px 10px;
    }

    .sidebar-brand {
        justify-content: center;

        padding: 4px 0 22px;
    }

    .brand-text {
        display: none;
    }

    .brand-icon {
        width: 42px;
        height: 42px;
    }

    .nav-section-title {
        display: none;
    }

    .dashboard-nav-link {
        justify-content: center;

        padding: 12px 8px;
    }

    .dashboard-nav-link span:last-child {
        display: none;
    }

    .nav-icon {
        width: auto;
        font-size: 19px;
    }

    .logout-button {
        justify-content: center;

        padding: 12px 8px;
    }

    .logout-button span:last-child {
        display: none;
    }

    .dashboard-main {
        margin-left: 72px;

        padding: 20px 16px;
    }
}


/* ---------- Small Phones ---------- */

@media (max-width: 380px) {

    .dashboard-sidebar {
        width: 62px;

        padding-left: 7px;
        padding-right: 7px;
    }

    .dashboard-main {
        margin-left: 62px;

        padding: 16px 12px;
    }

    .brand-icon {
        width: 38px;
        height: 38px;
    }

    .dashboard-nav-link {
        padding: 11px 5px;
    }

    .nav-icon {
        font-size: 17px;
    }
}
/* ========================================
   DASHBOARD HEADER
   ======================================== */

.dashboard-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;

    margin-bottom: 30px;
}


/* ---------- Welcome ---------- */

.dashboard-welcome {
    min-width: 0;
}

.welcome-label {
    font-size: 13px;
    font-weight: 650;

    color: #7b8194;

    margin-bottom: 5px;
}

.dashboard-welcome h1 {
    font-size: 28px;
    line-height: 1.25;

    font-weight: 750;

    color: #202331;

    margin-bottom: 6px;
}

.welcome-subtitle {
    font-size: 14px;

    color: #858b9c;

    line-height: 1.5;
}


/* ---------- Header Actions ---------- */

.dashboard-header-actions {
    display: flex;
    align-items: center;

    gap: 14px;
}


/* ---------- Notification ---------- */

.header-icon-button {
    position: relative;

    width: 42px;
    height: 42px;

    border: 1px solid #e7e9f0;

    background: #ffffff;

    border-radius: 12px;

    display: flex;
    align-items: center;
    justify-content: center;

    font-size: 18px;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        background 0.2s ease,
        box-shadow 0.2s ease;
}

.header-icon-button:hover {
    background: #f5f6fb;

    transform: translateY(-1px);

    box-shadow:
        0 5px 16px rgba(30, 40, 80, 0.08);
}


/* ---------- Notification Badge ---------- */

.notification-badge {
    position: absolute;

    top: -4px;
    right: -4px;

    min-width: 17px;
    height: 17px;

    padding: 0 4px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #536dfe;

    color: #ffffff;

    border: 2px solid #f6f8fc;

    border-radius: 20px;

    font-size: 9px;
    font-weight: 750;
}


/* ---------- Dashboard Profile ---------- */

.dashboard-profile {
    display: flex;
    align-items: center;

    gap: 10px;

    text-decoration: none;

    padding: 5px 8px 5px 5px;

    border-radius: 14px;

    transition:
        background 0.2s ease;
}

.dashboard-profile:hover {
    background: #ffffff;
}


.dashboard-profile-image {
    width: 42px;
    height: 42px;

    border-radius: 12px;

    object-fit: cover;

    background: #eef0f5;

    border: 1px solid #e5e7ee;
}


.dashboard-profile-info {
    display: flex;
    flex-direction: column;

    min-width: 70px;
}

.dashboard-profile-info strong {
    font-size: 13px;
    font-weight: 700;

    color: #272a38;

    line-height: 1.3;
}

.dashboard-profile-info span {
    font-size: 11px;

    color: #858b9c;

    margin-top: 2px;
}


/* ---------- Header Responsive ---------- */

@media (max-width: 768px) {

    .dashboard-header {
        align-items: flex-start;

        gap: 14px;

        margin-bottom: 24px;
    }

    .dashboard-welcome h1 {
        font-size: 22px;
    }

    .welcome-subtitle {
        font-size: 12px;
    }

    .dashboard-profile-info {
        display: none;
    }

    .dashboard-profile {
        padding: 0;
    }

    .dashboard-profile-image {
        width: 40px;
        height: 40px;

        border-radius: 11px;
    }

    .header-icon-button {
        width: 40px;
        height: 40px;
    }
}


@media (max-width: 380px) {

    .welcome-label {
        font-size: 12px;
    }

    .dashboard-welcome h1 {
        font-size: 19px;
    }

    .welcome-subtitle {
        display: none;
    }

    .dashboard-header-actions {
        gap: 8px;
    }

    .header-icon-button {
        width: 37px;
        height: 37px;
    }

    .dashboard-profile-image {
        width: 37px;
        height: 37px;
    }
}
/* ========================================
   STUDY OVERVIEW
   ======================================== */

.study-overview {
    width: 100%;
    margin-bottom: 32px;
}


/* ---------- Section Heading ---------- */

.section-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 16px;
}

.section-label {
    font-size: 10px;
    font-weight: 750;

    letter-spacing: 1px;

    color: #9a9fad;

    margin-bottom: 4px;
}

.section-heading h2 {
    font-size: 19px;
    font-weight: 750;

    color: #202331;
}


/* ---------- Overview Grid ---------- */

.overview-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;
}


/* ---------- Overview Card ---------- */

.overview-card {
    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 16px;

    padding: 18px;

    min-width: 0;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.overview-card:hover {
    transform: translateY(-2px);

    box-shadow:
        0 10px 25px rgba(30, 40, 80, 0.07);
}


/* ---------- Card Top ---------- */

.overview-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 8px;
}


/* ---------- Icons ---------- */

.overview-icon {
    width: 40px;
    height: 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    font-size: 19px;
}

.subjects-icon {
    background: #eef2ff;
}

.assignments-icon {
    background: #fff4e8;
}

.goals-icon {
    background: #edf9f1;
}

.study-time-icon {
    background: #f4edff;
}


/* ---------- Status ---------- */

.overview-status {
    font-size: 11px;
    font-weight: 650;

    color: #8a90a1;
}


/* ---------- Value ---------- */

.overview-value {
    margin-top: 20px;

    font-size: 28px;
    font-weight: 800;

    line-height: 1;

    color: #202331;
}


/* ---------- Description ---------- */

.overview-description {
    margin-top: 8px;

    font-size: 12px;

    color: #858b9c;

    line-height: 1.4;
}


/* ---------- Tablet ---------- */

@media (max-width: 1000px) {

    .overview-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}


/* ---------- Mobile ---------- */

@media (max-width: 600px) {

    .overview-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        gap: 10px;
    }

    .overview-card {
        padding: 14px;

        border-radius: 14px;
    }

    .overview-icon {
        width: 36px;
        height: 36px;

        font-size: 17px;
    }

    .overview-status {
        display: none;
    }

    .overview-value {
        margin-top: 16px;

        font-size: 24px;
    }

    .overview-description {
        font-size: 11px;
    }

    .section-heading h2 {
        font-size: 17px;
    }
}
/* ========================================
   TODAY'S STUDY
   ======================================== */

.today-study-section {
    width: 100%;
    margin-bottom: 32px;
}


/* ---------- View Schedule ---------- */

.section-view-link {
    display: inline-flex;
    align-items: center;

    padding: 8px 12px;

    border-radius: 9px;

    background: #f0f2ff;

    color: #4c5ce7;

    text-decoration: none;

    font-size: 12px;
    font-weight: 700;

    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.section-view-link:hover {
    background: #e7eaff;

    transform: translateY(-1px);
}


/* ---------- Study List ---------- */

.today-study-list {
    display: flex;
    flex-direction: column;

    gap: 10px;
}


/* ---------- Empty State ---------- */

.today-study-empty {
    display: flex;
    align-items: center;

    gap: 14px;

    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 16px;

    padding: 22px;

    min-height: 100px;
}

.empty-study-icon {
    width: 46px;
    height: 46px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: #eef2ff;

    font-size: 21px;
}

.today-study-empty h3 {
    font-size: 14px;
    font-weight: 700;

    color: #303342;

    margin-bottom: 4px;
}

.today-study-empty p {
    font-size: 12px;

    color: #858b9c;

    line-height: 1.5;
}


/* ---------- Real Study Item ---------- */

.today-study-item {
    display: flex;
    align-items: center;

    gap: 14px;

    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 14px;

    padding: 15px 17px;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.today-study-item:hover {
    transform: translateY(-1px);

    box-shadow:
        0 8px 20px rgba(30, 40, 80, 0.06);
}


.study-time {
    width: 76px;

    flex-shrink: 0;

    font-size: 12px;
    font-weight: 700;

    color: #596174;
}

.study-item-icon {
    width: 40px;
    height: 40px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 11px;

    background: #eef2ff;

    font-size: 18px;
}

.study-item-info {
    flex: 1;

    min-width: 0;
}

.study-item-info h3 {
    font-size: 14px;
    font-weight: 700;

    color: #292c39;

    margin-bottom: 4px;
}

.study-item-info p {
    font-size: 11px;

    color: #858b9c;
}


/* ---------- Mobile ---------- */

@media (max-width: 600px) {

    .section-view-link {
        padding: 7px 9px;

        font-size: 10px;
    }

    .today-study-empty {
        padding: 17px;

        min-height: 88px;
    }

    .empty-study-icon {
        width: 40px;
        height: 40px;

        font-size: 18px;
    }

    .today-study-empty h3 {
        font-size: 13px;
    }

    .today-study-empty p {
        font-size: 11px;
    }

    .today-study-item {
        gap: 10px;

        padding: 13px;
    }

    .study-time {
        width: 62px;

        font-size: 10px;
    }

    .study-item-icon {
        width: 35px;
        height: 35px;

        font-size: 16px;
    }

    .study-item-info h3 {
        font-size: 12px;
    }

    .study-item-info p {
        font-size: 10px;
    }
}
/* ========================================
   STUDYMATE AI
   ======================================== */

.studymate-section {
    width: 100%;
    margin-bottom: 32px;
}


/* ---------- Main Card ---------- */

.studymate-card {
    position: relative;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 30px;

    min-height: 210px;

    padding: 30px 34px;

    overflow: hidden;

    border-radius: 20px;

    background:
        linear-gradient(
            135deg,
            #f4f6ff 0%,
            #ffffff 55%,
            #f7f3ff 100%
        );

    border: 1px solid #e2e5f5;

    box-shadow:
        0 10px 30px rgba(55, 65, 120, 0.06);
}


/* ---------- Content ---------- */

.studymate-content {
    position: relative;

    z-index: 2;

    max-width: 600px;
}

.studymate-badge {
    display: inline-flex;
    align-items: center;

    padding: 6px 10px;

    margin-bottom: 13px;

    border-radius: 20px;

    background: #e9edff;

    color: #4c5ce7;

    font-size: 11px;
    font-weight: 750;
}

.studymate-content h2 {
    font-size: 24px;
    line-height: 1.3;

    font-weight: 800;

    color: #202331;

    margin-bottom: 9px;
}

.studymate-content p {
    max-width: 540px;

    font-size: 13px;

    line-height: 1.6;

    color: #70778a;

    margin-bottom: 18px;
}


/* ---------- Button ---------- */

.studymate-button {
    display: inline-flex;
    align-items: center;

    gap: 9px;

    padding: 10px 15px;

    border-radius: 10px;

    background: #536dfe;

    color: #ffffff;

    text-decoration: none;

    font-size: 12px;
    font-weight: 700;

    box-shadow:
        0 6px 16px rgba(83, 109, 254, 0.22);

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.studymate-button:hover {
    transform: translateY(-2px);

    box-shadow:
        0 9px 20px rgba(83, 109, 254, 0.28);
}

.studymate-button span {
    font-size: 16px;
    line-height: 1;
}


/* ---------- AI Visual ---------- */

.studymate-visual {
    position: relative;

    width: 180px;
    height: 180px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
}

.ai-core {
    position: relative;

    width: 72px;
    height: 72px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: #ffffff;

    border: 1px solid #dfe3f5;

    box-shadow:
        0 10px 30px rgba(70, 80, 150, 0.12);

    font-size: 32px;

    z-index: 3;
}


/* ---------- Orbit ---------- */

.ai-orbit {
    position: absolute;

    border: 1px solid #d9def8;

    border-radius: 50%;
}

.orbit-one {
    width: 120px;
    height: 120px;

    transform: rotate(25deg);
}

.orbit-two {
    width: 165px;
    height: 165px;

    transform: rotate(-30deg);
}


/* ---------- Tablet ---------- */

@media (max-width: 800px) {

    .studymate-card {
        padding: 24px;

        gap: 15px;
    }

    .studymate-content h2 {
        font-size: 21px;
    }

    .studymate-visual {
        width: 140px;
        height: 140px;
    }

    .ai-core {
        width: 62px;
        height: 62px;

        font-size: 27px;
    }

    .orbit-one {
        width: 100px;
        height: 100px;
    }

    .orbit-two {
        width: 130px;
        height: 130px;
    }
}


/* ---------- Mobile ---------- */

@media (max-width: 600px) {

    .studymate-card {
        min-height: 0;

        padding: 22px;

        border-radius: 17px;
    }

    .studymate-content {
        max-width: 100%;
    }

    .studymate-content h2 {
        font-size: 19px;
    }

    .studymate-content p {
        font-size: 11px;
    }

    .studymate-visual {
        display: none;
    }

    .studymate-button {
        padding: 9px 12px;

        font-size: 11px;
    }
}
/* ========================================
   STUDY PROGRESS
   ======================================== */

.study-progress-section {
    width: 100%;

    margin-bottom: 32px;
}


/* ---------- Progress List ---------- */

.study-progress-list {
    display: flex;
    flex-direction: column;

    gap: 10px;
}


/* ---------- Empty State ---------- */

.study-progress-empty {
    display: flex;
    align-items: center;

    gap: 14px;

    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 16px;

    padding: 22px;

    min-height: 100px;
}

.progress-empty-icon {
    width: 46px;
    height: 46px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background: #f3efff;

    font-size: 21px;
}

.study-progress-empty h3 {
    font-size: 14px;
    font-weight: 700;

    color: #303342;

    margin-bottom: 4px;
}

.study-progress-empty p {
    font-size: 12px;

    color: #858b9c;

    line-height: 1.5;
}


/* ---------- Real Progress Item ---------- */

.study-progress-item {
    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 14px;

    padding: 16px 18px;
}

.progress-item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 12px;

    margin-bottom: 10px;
}

.progress-subject {
    font-size: 13px;
    font-weight: 700;

    color: #292c39;
}

.progress-percentage {
    font-size: 12px;
    font-weight: 750;

    color: #536dfe;
}


/* ---------- Progress Bar ---------- */

.progress-bar {
    width: 100%;
    height: 7px;

    background: #edf0f5;

    border-radius: 20px;

    overflow: hidden;
}

.progress-bar-fill {
    height: 100%;

    width: 0%;

    background: #536dfe;

    border-radius: inherit;

    transition:
        width 0.5s ease;
}


/* ---------- Mobile ---------- */

@media (max-width: 600px) {

    .study-progress-empty {
        padding: 17px;

        min-height: 88px;
    }

    .progress-empty-icon {
        width: 40px;
        height: 40px;

        font-size: 18px;
    }

    .study-progress-empty h3 {
        font-size: 13px;
    }

    .study-progress-empty p {
        font-size: 11px;
    }

    .study-progress-item {
        padding: 14px;
    }

    .progress-subject {
        font-size: 12px;
    }

    .progress-percentage {
        font-size: 11px;
    }
}
/* ========================================
   QUICK ACTIONS
   ======================================== */

.quick-actions-section {
    width: 100%;

    margin-bottom: 32px;
}


/* ---------- Grid ---------- */

.quick-actions-grid {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 12px;
}


/* ---------- Card ---------- */

.quick-action-card {
    display: flex;
    align-items: center;

    gap: 12px;

    min-width: 0;

    padding: 15px;

    background: #ffffff;

    border: 1px solid #e8eaf0;

    border-radius: 14px;

    text-decoration: none;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease,
        border-color 0.2s ease;
}

.quick-action-card:hover {
    transform: translateY(-2px);

    border-color: #dfe3f5;

    box-shadow:
        0 8px 22px rgba(30, 40, 80, 0.07);
}


/* ---------- Icon ---------- */

.quick-action-icon {
    width: 40px;
    height: 40px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #f1f3fa;

    border-radius: 11px;

    font-size: 18px;
}


/* ---------- Info ---------- */

.quick-action-info {
    display: flex;
    flex-direction: column;

    min-width: 0;

    flex: 1;
}

.quick-action-info strong {
    font-size: 13px;
    font-weight: 700;

    color: #292c39;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.quick-action-info span {
    margin-top: 3px;

    font-size: 10px;

    color: #858b9c;

    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}


/* ---------- Arrow ---------- */

.quick-action-arrow {
    flex-shrink: 0;

    font-size: 17px;

    color: #a0a5b4;

    transition:
        transform 0.2s ease,
        color 0.2s ease;
}

.quick-action-card:hover
.quick-action-arrow {
    transform: translateX(3px);

    color: #536dfe;
}


/* ---------- Tablet ---------- */

@media (max-width: 900px) {

    .quick-actions-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }

}


/* ---------- Mobile ---------- */

@media (max-width: 600px) {

    .quick-actions-grid {
        grid-template-columns:
            1fr;
    }

    .quick-action-card {
        padding: 13px;
    }

    .quick-action-icon {
        width: 38px;
        height: 38px;

        font-size: 17px;
    }

    .quick-action-info strong {
        font-size: 12px;
    }

    .quick-action-info span {
        font-size: 10px;
    }
}
